  "faqs": [
    {
      "q": "What is the MAT exam?",
      "a": "MAT is a national-level MBA entrance test conducted by AIMA and accepted by over 600 B-Schools in India."
    },
    {
      "q": "What is the eligibility for MAT?",
      "a": "Graduation in any discipline. Final-year students can also apply. There is no age limit."
    },
    {
      "q": "How many times is MAT conducted?",
      "a": "Four times a year — February, May, September, and December."
    },
    {
      "q": "What are the test modes?",
      "a": "PBT (Offline), CBT (Online), and sometimes IBT."
    },
    {
      "q": "How does Career Laksh help?",
      "a": "Free counselling, college shortlisting, documentation support, and low-budget or city-specific options."
    }
  ],

